@model Depi_Project.Models.Gym

<header class="header">
    <div class="container navbar">
        <div class="brand"><div class="logo">🏋️</div> FitConnect</div>
        <nav class="navlinks">
            <a asp-controller="gymowner" asp-action="dashboard" style="color: var(--text);">Dashboard</a>
            <a asp-controller="gymowner" asp-action="media">Media</a>
            <a asp-controller="gymowner" asp-action="bookings">Bookings</a>
            <a asp-controller="home" asp-action="index">Logout</a>
        </nav>
    </div>
</header>

<section class="section">
    <div class="container">

        <h1 class="section-title">Media Management</h1>
        <p class="section-sub">Upload and manage your gym's photos & videos</p>

        <div class="card">
            <div class="card-header">
                <h3>Upload New Media</h3>
            </div>

            <div class="card-body">
                <form asp-action="UploadMedia" asp-controller="GymOwner" enctype="multipart/form-data">
                    <input type="hidden" name="gymId" value="@Model.Id" />

                    <div class="mb-3">
                        <label>Select File</label>
                        <input type="file" name="file" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label>Media Type</label>
                        <select name="type" class="form-control">
                            <option value="photo">Photo</option>
                            <option value="video">Video</option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-primary">Upload</button>
                </form>
            </div>
        </div>

        <h2 style="margin-top: 30px;">Current Media</h2>

        <div class="row mt-3">
            @foreach (var m in Model.Media)
            {
                <div class="col-3 mb-4">
                    <div class="card">
                        @if (m.Type == "photo")
                        {
                            <img src="@m.Url" class="img-fluid" style="height:180px; object-fit:cover;" />
                        }
                        else
                        {
                            <video src="@m.Url" controls style="width:100%; height:180px; object-fit:cover;"></video>
                        }

                        <div class="card-body text-center">
                            <form asp-action="DeleteMedia" method="post">
                                <input type="hidden" name="id" value="@m.Id" />
                                <button class="btn btn-danger btn-sm">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</section>
