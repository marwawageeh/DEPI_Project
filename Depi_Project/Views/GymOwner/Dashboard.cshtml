@model GymDashboardVM

<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>Gym Dashboard • FitConnect</title>
	<link rel="stylesheet" href="~/css/style.css" />
	<style>
		.dashboard-layout {
			display: grid;
			grid-template-columns: 1fr 400px;
			gap: 24px;
			margin-top: 24px;
		}

		.gym-image {
			width: 100%;
			height: 200px;
			object-fit: cover;
			border-radius: 12px;
			margin-bottom: 16px;
		}

		.booking-item {
			padding: 16px 0;
			border-bottom: 1px solid #eef2f7;
		}

			.booking-item:last-child {
				border-bottom: none;
			}

		.booking-time {
			color: var(--muted);
			font-size: 14px;
			margin-bottom: 8px;
		}

		.booking-badges {
			display: flex;
			gap: 8px;
		}

		.action-cards {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 18px;
			margin-top: 24px;
		}

		.action-card {
			text-align: center;
			padding: 24px;
		}

			.action-card .btn {
				width: 100%;
				margin-top: 12px;
			}
	</style>
</head>
<body>
	<header class="header">
		<div class="container navbar">
			<div class="brand"><div class="logo">🏋️</div> FitConnect</div>
			<nav class="navlinks">
				<a asp-controller="GymOwner" asp-action="Dashboard" style="color: var(--text);">Dashboard</a>
				<a asp-controller="GymOwner" asp-action="Media">Media</a>
				<a asp-controller="GymOwner" asp-action="Bookings">Bookings</a>
				<a asp-controller="Home" asp-action="Index">Logout</a>
			</nav>
		</div>
	</header>

	<section class="section">
		<div class="container">
			<h1 class="section-title">Gym Dashboard</h1>
			<p class="section-sub">Manage your gym and track performance</p>

			<div class="kpis">
				<div class="kpi">
					<div>
						<div style="color: var(--muted); font-size: 14px; margin-bottom: 4px;">Total Bookings</div>
						<div class="value">@Model.TotalBookings</div>
						<div style="color: var(--success); font-size: 12px; margin-top: 4px;">↗ +12% this week</div>
					</div>
					<div style="color: var(--primary); font-size: 24px;">📅</div>
				</div>

				<div class="kpi">
					<div>
						<div style="color: var(--muted); font-size: 14px; margin-bottom: 4px;">Total Revenue</div>
						<div class="value">$@Model.TotalRevenue</div>
						<div style="color: var(--success); font-size: 12px; margin-top: 4px;">↗ +8% this month</div>
					</div>
					<div style="color: var(--accent); font-size: 24px;">💰</div>
				</div>

				<div class="kpi">
					<div>
						<div style="color: var(--muted); font-size: 14px; margin-bottom: 4px;">Avg Rating</div>
						<div class="value">@Model.AvgRating.ToString("0.0")</div>
						<div style="color: var(--muted); font-size: 12px; margin-top: 4px;">Based on @Model.ReviewsCount reviews</div>
					</div>
					<div style="color: var(--accent); font-size: 24px;">⭐</div>
				</div>
			</div>

			<div class="dashboard-layout">
				<div class="card">
					<img src="@Model.Gym.Media?.FirstOrDefault()?.Url" class="gym-image" />
					<div class="card-body">
						<h3>@Model.Gym.Name</h3>

						<div class="info-row" style="margin: 8px 0;">
							<span>📍</span>
							<span>@Model.Gym.Address</span>
						</div>
						<div class="info-row" style="margin: 8px 0;">
							<span>📞</span>
							<span>@Model.Gym.Phone</span>
						</div>
						<div class="info-row" style="margin: 8px 0;">
							<span>✉️</span>
							<span>@Model.Gym.Email</span>
						</div>
						<div class="info-row" style="margin: 8px 0;">
							<span>🕒</span>
							<span>@Model.Gym.OpeningHours</span>
						</div>
					</div>
				</div>

				<div class="card">
					<div class="card-header">
						<h3>Recent Bookings</h3>
						<a asp-action="Bookings" asp-controller="GymOwner" style="color: var(--primary); font-size: 14px;">View All</a>
					</div>
					<div class="card-body">
						@foreach (var b in Model.RecentBookings)
						{
							<div class="booking-item">
								<div class="booking-time">📅 @b.StartDate.ToString("MMMM dd, hh:mm tt")</div>
								<div class="booking-badges">
									<span class="badge gray">@b.Type</span>
									@if (b.IsConfirmedByOwner)
									{
										<span class="badge teal">Confirmed</span>
									}
									else
									{
										<span class="badge orange">Pending</span>
									}
								</div>
							</div>
						}
					</div>
				</div>
			</div>

			<div class="action-cards">
				<div class="card action-card">
					<h3>Manage Media</h3>
					<p style="color: var(--muted); margin: 8px 0;">Upload and manage photos & videos</p>
					<a asp-action="Media" asp-controller="GymOwner" class="btn btn-primary">Manage Media</a>
				</div>

				<div class="card action-card">
					<h3>View Bookings</h3>
					<p style="color: var(--muted); margin: 8px 0;">Manage session bookings</p>
					<a asp-action="Bookings" asp-controller="GymOwner" class="btn btn-accent">View Bookings</a>
				</div>
			</div>

		</div>
	</section>

	<script src="~/js/main.js"></script>
</body>
</html>
