@model Depi_Project.Models.ViewModels.GymBookingsVM
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Booking Management • FitConnect</title>
    <link rel="stylesheet" href="../css/style.css" />
    <style>
        .booking-filters {
            display: flex;
            gap: 12px;
            margin: 20px 0;
        }

        .filter-tab {
            padding: 8px 16px;
            border-radius: 20px;
            background: #f2f6fa;
            color: var(--muted);
            cursor: pointer;
            transition: .2s;
        }

            .filter-tab.active {
                background: white;
                color: var(--text);
                box-shadow: var(--shadow);
            }

        .search-bar {
            display: flex;
            gap: 12px;
            margin: 20px 0;
        }

        .search-input {
            flex: 1;
        }

        .booking-table {
            overflow-x: auto;
        }

        .table-actions {
            display: flex;
            gap: 8px;
        }

        .action-btn {
            padding: 6px 12px;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            font-size: 12px;
            font-weight: 600;
        }

            .action-btn.approve {
                background: var(--primary);
                color: white;
            }

            .action-btn.cancel {
                background: var(--danger);
                color: white;
            }

        .badge.orange {
            background: #f5a623;
            color: white;
            padding: 4px 8px;
            border-radius: 6px;
        }

        .badge.teal {
            background: #1abc9c;
            color: white;
            padding: 4px 8px;
            border-radius: 6px;
        }

        .badge.red {
            background: #e74c3c;
            color: white;
            padding: 4px 8px;
            border-radius: 6px;
        }
    </style>
</head>
<body>
    <header class="header">
        <div class="container navbar">
            <div class="brand"><div class="logo">🏋️</div> FitConnect</div>
            <nav class="navlinks">
                <a asp-controller="GymOwner" asp-action="Dashboard">Dashboard</a>
                <a asp-controller="GymOwner" asp-action="Media">Media</a>
                <a asp-controller="GymOwner" asp-action="Bookings">Bookings</a>
                <a asp-controller="Home" asp-action="Index">Logout</a>
            </nav>
        </div>
    </header>

    <section class="section">
        <div class="container">
            <h1 class="section-title">Booking Management</h1>
            <p class="section-sub">View and manage all gym bookings</p>

            <!-- KPIs -->
            <div class="kpis">
                <div class="kpi">
                    <div>
                        <div style="color: var(--muted); font-size: 14px; margin-bottom: 4px;">Total Bookings</div>
                        <div class="value">@Model.Total</div>
                    </div>
                    <div style="color: var(--primary); font-size: 24px;">📅</div>
                </div>

                <div class="kpi">
                    <div>
                        <div style="color: var(--muted); font-size: 14px; margin-bottom: 4px;">Pending</div>
                        <div class="value">@Model.Pending</div>
                    </div>
                    <div style="color: var(--accent); font-size: 24px;">⏰</div>
                </div>

                <div class="kpi">
                    <div>
                        <div style="color: var(--muted); font-size: 14px; margin-bottom: 4px;">Confirmed</div>
                        <div class="value">@Model.Confirmed</div>
                    </div>
                    <div style="color: var(--success); font-size: 24px;">✅</div>
                </div>

                <div class="kpi">
                    <div>
                        <div style="color: var(--muted); font-size: 14px; margin-bottom: 4px;">Cancelled</div>
                        <div class="value">@Model.Cancelled</div>
                    </div>
                    <div style="color: var(--danger); font-size: 24px;">❌</div>
                </div>
            </div>

            <!-- Main Table -->
            <div class="card">
                <div class="card-header">
                    <h3>All Bookings</h3>

                    <div class="search-bar">
                        <form method="get" asp-action="Bookings" style="width:100%;">
                            <div class="search-input" style="position:relative;">
                                <input name="search" value="@Model.Search" class="input" placeholder="Search by name or email.." style="padding-left: 40px;" />
                                <span style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--muted);">🔍</span>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="card-body">
                    <!-- Filter Tabs -->
                    <div class="booking-filters">
                        <a asp-action="Bookings" asp-route-filter="All" class="filter-tab @(Model.Filter=="All" ? "active":"")">All</a>
                        <a asp-action="Bookings" asp-route-filter="Pending" class="filter-tab @(Model.Filter=="Pending" ? "active":"")">Pending</a>
                        <a asp-action="Bookings" asp-route-filter="Confirmed" class="filter-tab @(Model.Filter=="Confirmed" ? "active":"")">Confirmed</a>
                        <a asp-action="Bookings" asp-route-filter="Cancelled" class="filter-tab @(Model.Filter=="Cancelled" ? "active":"")">Cancelled</a>
                    </div>

                    <!-- Table -->
                    <div class="booking-table">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>User</th>
                                    <th>Type</th>
                                    <th>Date & Time</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var b in Model.Bookings)
                                {
                                    <tr>
                                        <td>
                                            <div>
                                                <div style="font-weight: 600;">@b.UserName</div>
                                                <div style="color: var(--muted); font-size: 14px;">@b.UserEmail</div>
                                            </div>
                                        </td>
                                        <td>@b.Type</td>
                                        <td>
                                            <div>@b.Date.ToString("yyyy-MM-dd")</div>
                                            <div style="color: var(--muted); font-size: 14px;">@b.Date.ToString("hh:mm tt")</div>
                                        </td>
                                        <td>$@b.Amount</td>
                                        <td>
                                            @if (b.Status == "Pending")
                                            {
                                                <span class="badge orange">Pending</span>
                                            }
                                            else if (b.Status == "Confirmed")
                                            {
                                                <span class="badge teal">Confirmed</span>
                                            }
                                            else
                                            {
                                                <span class="badge red">Cancelled</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="table-actions">
                                                @if (b.Status == "Pending")
                                                {
                                                    <form asp-action="ApproveBooking" method="post">
                                                        <input type="hidden" name="id" value="@b.Id" />
                                                        <button class="action-btn approve">✓ Approve</button>
                                                    </form>

                                                    <form asp-action="CancelBooking" method="post">
                                                        <input type="hidden" name="id" value="@b.Id" />
                                                        <button class="action-btn cancel">✕ Cancel</button>
                                                    </form>
                                                }
                                                else if (b.Status == "Confirmed")
                                                {
                                                    <form asp-action="CancelBooking" method="post">
                                                        <input type="hidden" name="id" value="@b.Id" />
                                                        <button class="action-btn cancel">✕ Cancel</button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </section>
</body>
</html>
